# Frontend env. Only VITE_-prefixed values reach the browser, so never put a
# Gemini key here — it belongs in backend/.env, server-side.

# Empty means "same origin", which is what you want when the Vite dev proxy or
# a production rewrite forwards /api to the backend. Set it to the backend's
# full URL if you deploy them to separate hosts.
VITE_API_URL=
